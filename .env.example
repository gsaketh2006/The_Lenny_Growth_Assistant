# ========================================================
# The Lenny Growth Assistant - Environment Configuration
# ========================================================

# Application Metadata
PROJECT_NAME=The Lenny Growth Assistant
VERSION=1.0.0
ENVIRONMENT=development
API_PREFIX=/api

# Database Persistence (Supabase / PostgreSQL / SQLite)
# Example Supabase: postgresql+asyncpg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# Example Local SQLite: sqlite+aiosqlite:///./lenny_growth.db
DATABASE_URL=sqlite+aiosqlite:///./lenny_growth.db

# Default Model Provider (ollama | anthropic | openai | groq)
DEFAULT_LLM_PROVIDER=ollama

# Local Ollama Configuration (Default Local Demo)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Cloud Provider API Keys (Optional - can also be configured via Web UI Settings)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# RAG & Retrieval Thresholds
TOP_K_RETRIEVAL=5
SIMILARITY_HIGH_THRESHOLD=0.58
SIMILARITY_MEDIUM_THRESHOLD=0.42
SIMILARITY_LOW_THRESHOLD=0.28
